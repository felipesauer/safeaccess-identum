{
    "testRunner": "vitest",
    "tsconfigFile": "tsconfig.stryker-none.json",
    "coverageAnalysis": "perTest",
    "timeoutMS": 30000,
    "mutate": [
        "src/**/*.ts",
        "!src/**/*.test.ts",
        "!src/index.ts",
        "!src/contracts/**/*.ts",
        "!src/exceptions/**/*.ts"
    ],
    "thresholds": {
        "high": 95,
        "low": 85,
        "break": 85
    },
    "incremental": true,
    "incrementalFile": "reports/mutation/.incremental.json",
    "reporters": ["json", "clear-text", "progress", "dashboard"],
    "jsonReporter": {
        "fileName": "reports/mutation/mutation.json"
    },
    "dashboard": {
        "project": "github.com/felipesauer/safeaccess-identum",
        "version": "main",
        "reportType": "full"
    }
}
